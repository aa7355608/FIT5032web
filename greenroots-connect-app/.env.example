# Copy this file to .env and fill in the values from:
# Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK setup
# (These identify your project; they are not secrets. Access is controlled by
#  Firebase Auth and firestore.rules.)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# How long a login lasts (rebuild/restart after changing):
#   none (default) = must log in every time the page is opened or refreshed
#   tab            = survives refresh, ends when the tab is closed
#   browser        = survives closing the browser
VITE_AUTH_PERSISTENCE=none
